"use client";

import {
  AlertTriangle,
  CheckCircle2,
  CircleDollarSign,
  Loader2,
  Save,
  Send,
} from "lucide-react";
import { useMemo, useState } from "react";

type PriceConfirmationStatus = "pending" | "confirmed" | "changed";

type InquiryItem = {
  id: string;
  isbn: string;
  title: string;
  subtitle: string | null;
  authors: string[] | null;
  publisher: string | null;
  cover_url: string | null;
  requested_quantity: number;
  availability_status: string;
  available_quantity: number | null;
  lead_time_days: number | null;
  available_from: string | null;
  reservation_until: string | null;
  supplier_note: string | null;
  linked_product_id: string | null;
  proposed_price_gross: number | null;
  proposed_tax_rate: number | null;
  price_source: string | null;
  price_confirmation_status: PriceConfirmationStatus;
  confirmed_price_gross: number | null;
  confirmed_tax_rate: number | null;
  price_confirmed_at: string | null;
  price_applied_to_product_at: string | null;
};

type Props = {
  token: string;
  inquiryNumber: string;
  initialSupplierNote: string | null;
  initialItems: InquiryItem[];
};

const STATUS_OPTIONS = [
  ["pending", "Noch nicht beantwortet"],
  ["in_store", "Im Laden verfügbar"],
  ["orderable", "Bestellbar"],
  ["partially_available", "Teilweise verfügbar"],
  ["unavailable", "Nicht verfügbar"],
  ["checking", "Noch zu prüfen"],
] as const;

function toPrice(value: unknown) {
  if (value === null || value === undefined || value === "") return null;

  const parsed = Number(String(value).replace(",", "."));

  if (!Number.isFinite(parsed) || parsed <= 0 || parsed > 5000) {
    return null;
  }

  return Math.round(parsed * 100) / 100;
}

function formatPrice(value: number | null) {
  if (value === null) return "Nicht angegeben";

  return new Intl.NumberFormat("de-DE", {
    style: "currency",
    currency: "EUR",
  }).format(value);
}

function normalizeInitialItem(item: InquiryItem): InquiryItem {
  const proposedTaxRate = Number(item.proposed_tax_rate) === 19 ? 19 : 7;
  const confirmedTaxRate =
    Number(item.confirmed_tax_rate) === 19
      ? 19
      : Number(item.confirmed_tax_rate) === 7
        ? 7
        : null;

  return {
    ...item,
    proposed_price_gross: toPrice(item.proposed_price_gross),
    proposed_tax_rate: proposedTaxRate,
    price_confirmation_status:
      item.price_confirmation_status === "confirmed" ||
      item.price_confirmation_status === "changed"
        ? item.price_confirmation_status
        : "pending",
    confirmed_price_gross:
      toPrice(item.confirmed_price_gross) ?? toPrice(item.proposed_price_gross),
    confirmed_tax_rate: confirmedTaxRate ?? proposedTaxRate,
  };
}

export default function BookSupplierResponseForm({
  token,
  inquiryNumber,
  initialSupplierNote,
  initialItems,
}: Props) {
  const [supplierNote, setSupplierNote] = useState(initialSupplierNote || "");
  const [items, setItems] = useState(() =>
    initialItems.map(normalizeInitialItem),
  );
  const [isSaving, setIsSaving] = useState(false);
  const [success, setSuccess] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);

  const progress = useMemo(() => {
    const availabilityDone = items.filter(
      (item) => item.availability_status !== "pending",
    ).length;
    const priceDone = items.filter(
      (item) =>
        item.price_confirmation_status === "confirmed" ||
        item.price_confirmation_status === "changed",
    ).length;

    return {
      availabilityDone,
      priceDone,
      total: items.length,
    };
  }, [items]);

  function updateItem(itemId: string, patch: Partial<InquiryItem>) {
    setItems((current) =>
      current.map((item) =>
        item.id === itemId
          ? {
              ...item,
              ...patch,
            }
          : item,
      ),
    );
  }

  function setPriceConfirmation(
    item: InquiryItem,
    status: PriceConfirmationStatus,
  ) {
    if (status === "confirmed" && item.proposed_price_gross === null) {
      setError(
        `Für „${item.title}“ fehlt ein vorgeschlagener Preis. Bitte wählen Sie „Preis/USt. ändern“ und tragen Sie den gültigen Preis ein.`,
      );
      return;
    }

    updateItem(item.id, {
      price_confirmation_status: status,
      confirmed_price_gross:
        status === "confirmed"
          ? item.proposed_price_gross
          : item.confirmed_price_gross ?? item.proposed_price_gross,
      confirmed_tax_rate:
        status === "confirmed"
          ? Number(item.proposed_tax_rate) === 19
            ? 19
            : 7
          : item.confirmed_tax_rate ?? item.proposed_tax_rate ?? 7,
    });
    setError(null);
  }

  function validateCompletion() {
    for (const item of items) {
      if (item.availability_status === "pending") {
        return `Bitte beantworten Sie zuerst die Verfügbarkeit für „${item.title}“.`;
      }

      if (item.price_confirmation_status === "pending") {
        return `Bitte bestätigen oder ändern Sie Preis und Umsatzsteuer für „${item.title}“.`;
      }

      if (
        item.price_confirmation_status === "changed" &&
        toPrice(item.confirmed_price_gross) === null
      ) {
        return `Bitte tragen Sie für „${item.title}“ einen gültigen Bruttopreis ein.`;
      }

      if (
        item.confirmed_tax_rate !== 7 &&
        item.confirmed_tax_rate !== 19
      ) {
        return `Bitte wählen Sie für „${item.title}“ einen gültigen Umsatzsteuersatz.`;
      }
    }

    return null;
  }

  async function saveResponse(complete: boolean) {
    if (isSaving) return;

    if (complete) {
      const validationError = validateCompletion();

      if (validationError) {
        setError(validationError);
        setSuccess(null);
        return;
      }
    }

    setIsSaving(true);
    setSuccess(null);
    setError(null);

    try {
      const response = await fetch(
        `/api/book-supplier/inquiries/${encodeURIComponent(token)}`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            supplierNote,
            complete,
            items: items.map((item) => ({
              id: item.id,
              availabilityStatus: item.availability_status,
              availableQuantity: item.available_quantity,
              leadTimeDays: item.lead_time_days,
              availableFrom: item.available_from,
              reservationUntil: item.reservation_until,
              supplierNote: item.supplier_note,
              priceConfirmationStatus: item.price_confirmation_status,
              confirmedPriceGross: item.confirmed_price_gross,
              confirmedTaxRate: item.confirmed_tax_rate,
            })),
          }),
        },
      );

      const payload = (await response.json()) as {
        ok?: boolean;
        message?: string;
        items?: InquiryItem[];
      };

      if (!response.ok || !payload.ok) {
        throw new Error(
          payload.message || "Die Rückmeldung konnte nicht gespeichert werden.",
        );
      }

      if (Array.isArray(payload.items)) {
        setItems(payload.items.map(normalizeInitialItem));
      }

      setSuccess(
        payload.message ||
          `Die Rückmeldung zu ${inquiryNumber} wurde gespeichert.`,
      );
    } catch (caughtError) {
      setError(
        caughtError instanceof Error
          ? caughtError.message
          : "Die Rückmeldung konnte nicht gespeichert werden.",
      );
    } finally {
      setIsSaving(false);
    }
  }

  return (
    <div className="grid gap-5">
      <section className="rounded-[28px] border border-[#C8D8E8] bg-[#EEF4FA] p-5">
        <div className="flex items-start gap-3">
          <CircleDollarSign className="mt-0.5 h-6 w-6 shrink-0 text-[#12395F]" />
          <div>
            <h2 className="text-lg font-black text-[#102A43]">
              Preis und Umsatzsteuer je Position verpflichtend prüfen
            </h2>
            <p className="mt-1 text-sm font-semibold leading-6 text-[#52616F]">
              Der vorgeschlagene Preis kann bestätigt oder korrigiert werden.
              Bei einer Korrektur wird der neue Wert für zukünftige Verkäufe in
              das verknüpfte Produkt übernommen. Bereits abgeschlossene Verkäufe
              bleiben unverändert.
            </p>
          </div>
        </div>

        <div className="mt-4 grid gap-3 sm:grid-cols-2">
          <div className="rounded-2xl bg-white p-3">
            <p className="text-xs font-black uppercase text-[#12395F]">
              Verfügbarkeit beantwortet
            </p>
            <p className="mt-1 text-xl font-black text-[#102A43]">
              {progress.availabilityDone} / {progress.total}
            </p>
          </div>
          <div className="rounded-2xl bg-white p-3">
            <p className="text-xs font-black uppercase text-[#12395F]">
              Preis und USt. geprüft
            </p>
            <p className="mt-1 text-xl font-black text-[#102A43]">
              {progress.priceDone} / {progress.total}
            </p>
          </div>
        </div>
      </section>

      {success ? (
        <div className="flex items-start gap-3 rounded-2xl border border-[#BFE3CD] bg-[#F0FFF6] p-4 text-[#2F7D50]">
          <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0" />
          <p className="font-bold leading-6">{success}</p>
        </div>
      ) : null}

      {error ? (
        <div className="flex items-start gap-3 rounded-2xl border border-[#F0B7BA] bg-[#FFF1F1] p-4 font-bold text-[#9F1D24]">
          <AlertTriangle className="mt-0.5 h-5 w-5 shrink-0" />
          <p>{error}</p>
        </div>
      ) : null}

      {items.map((item, index) => (
        <article
          key={item.id}
          className="rounded-[28px] border border-[#E8DED2] bg-white p-5 shadow-sm"
        >
          <div className="flex flex-col gap-4 sm:flex-row">
            <div className="h-36 w-24 shrink-0 overflow-hidden rounded-xl border border-[#E8DED2] bg-[#FBF7F0]">
              {item.cover_url ? (
                <img
                  src={item.cover_url}
                  alt={item.title}
                  className="h-full w-full object-contain p-1"
                />
              ) : null}
            </div>

            <div className="min-w-0 flex-1">
              <p className="text-xs font-black uppercase tracking-[0.14em] text-[#A75B28]">
                Position {index + 1}
              </p>
              <h2 className="mt-1 text-xl font-black text-[#102A43]">
                {item.title}
              </h2>

              {item.subtitle ? (
                <p className="mt-1 font-semibold text-[#52616F]">
                  {item.subtitle}
                </p>
              ) : null}

              <p className="mt-2 text-sm font-bold text-[#52616F]">
                ISBN {item.isbn} · Angefragt: {item.requested_quantity}{" "}
                Exemplar(e)
              </p>
            </div>
          </div>

          <div className="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <label className="block">
              <span className="mb-2 block text-sm font-black">
                Verfügbarkeit*
              </span>
              <select
                value={item.availability_status}
                onChange={(event) =>
                  updateItem(item.id, {
                    availability_status: event.target.value,
                  })
                }
                className="min-h-12 w-full rounded-2xl border border-[#D8C8B8] bg-white px-4 font-bold"
              >
                {STATUS_OPTIONS.map(([value, label]) => (
                  <option key={value} value={value}>
                    {label}
                  </option>
                ))}
              </select>
            </label>

            <label className="block">
              <span className="mb-2 block text-sm font-black">
                Verfügbare Menge
              </span>
              <input
                type="number"
                min={0}
                value={item.available_quantity ?? ""}
                onChange={(event) =>
                  updateItem(item.id, {
                    available_quantity:
                      event.target.value === ""
                        ? null
                        : Number(event.target.value),
                  })
                }
                className="min-h-12 w-full rounded-2xl border border-[#D8C8B8] bg-white px-4 font-bold"
              />
            </label>

            <label className="block">
              <span className="mb-2 block text-sm font-black">
                Lieferzeit in Tagen
              </span>
              <input
                type="number"
                min={0}
                value={item.lead_time_days ?? ""}
                onChange={(event) =>
                  updateItem(item.id, {
                    lead_time_days:
                      event.target.value === ""
                        ? null
                        : Number(event.target.value),
                  })
                }
                className="min-h-12 w-full rounded-2xl border border-[#D8C8B8] bg-white px-4 font-bold"
              />
            </label>

            <label className="block">
              <span className="mb-2 block text-sm font-black">
                Verfügbar ab
              </span>
              <input
                type="date"
                value={item.available_from || ""}
                onChange={(event) =>
                  updateItem(item.id, {
                    available_from: event.target.value || null,
                  })
                }
                className="min-h-12 w-full rounded-2xl border border-[#D8C8B8] bg-white px-4 font-bold"
              />
            </label>

            <label className="block">
              <span className="mb-2 block text-sm font-black">
                Reserviert bis
              </span>
              <input
                type="date"
                value={item.reservation_until || ""}
                onChange={(event) =>
                  updateItem(item.id, {
                    reservation_until: event.target.value || null,
                  })
                }
                className="min-h-12 w-full rounded-2xl border border-[#D8C8B8] bg-white px-4 font-bold"
              />
            </label>
          </div>

          <div className="mt-5 rounded-[24px] border border-[#F1D1A8] bg-[#FFF8EE] p-4">
            <p className="text-xs font-black uppercase tracking-[0.14em] text-[#A75B28]">
              Gebundener Verkaufspreis und Umsatzsteuer
            </p>

            <div className="mt-3 grid gap-3 sm:grid-cols-3">
              <div className="rounded-2xl border border-[#F1D1A8] bg-white p-3">
                <p className="text-xs font-black text-[#52616F]">
                  Vorschlag
                </p>
                <p className="mt-1 text-lg font-black text-[#102A43]">
                  {formatPrice(item.proposed_price_gross)}
                </p>
                <p className="mt-1 text-xs font-semibold text-[#52616F]">
                  USt. {Number(item.proposed_tax_rate) === 19 ? 19 : 7} %
                </p>
              </div>

              <button
                type="button"
                onClick={() => setPriceConfirmation(item, "confirmed")}
                className={`rounded-2xl border p-3 text-left transition ${
                  item.price_confirmation_status === "confirmed"
                    ? "border-[#2F7D50] bg-[#F0FFF6] ring-2 ring-[#2F7D50]/20"
                    : "border-[#D8C8B8] bg-white hover:border-[#2F7D50]"
                }`}
              >
                <p className="text-sm font-black text-[#102A43]">
                  Preis und USt. bestätigen
                </p>
                <p className="mt-1 text-xs font-semibold leading-5 text-[#52616F]">
                  Vorschlag unverändert übernehmen.
                </p>
              </button>

              <button
                type="button"
                onClick={() => setPriceConfirmation(item, "changed")}
                className={`rounded-2xl border p-3 text-left transition ${
                  item.price_confirmation_status === "changed"
                    ? "border-[#B5282D] bg-[#FFF1F1] ring-2 ring-[#B5282D]/15"
                    : "border-[#D8C8B8] bg-white hover:border-[#B5282D]"
                }`}
              >
                <p className="text-sm font-black text-[#102A43]">
                  Preis/USt. ändern
                </p>
                <p className="mt-1 text-xs font-semibold leading-5 text-[#52616F]">
                  Gültigen Wert korrigiert eintragen.
                </p>
              </button>
            </div>

            {item.price_confirmation_status === "changed" ? (
              <div className="mt-4 grid gap-3 sm:grid-cols-2">
                <label className="block">
                  <span className="mb-2 block text-sm font-black">
                    Korrigierter Bruttopreis*
                  </span>
                  <input
                    type="text"
                    inputMode="decimal"
                    value={
                      item.confirmed_price_gross === null
                        ? ""
                        : item.confirmed_price_gross
                            .toFixed(2)
                            .replace(".", ",")
                    }
                    onChange={(event) =>
                      updateItem(item.id, {
                        confirmed_price_gross: toPrice(event.target.value),
                      })
                    }
                    placeholder="z. B. 16,50"
                    className="min-h-12 w-full rounded-2xl border border-[#D8C8B8] bg-white px-4 font-bold"
                  />
                </label>

                <label className="block">
                  <span className="mb-2 block text-sm font-black">
                    Korrigierter Umsatzsteuersatz*
                  </span>
                  <select
                    value={item.confirmed_tax_rate === 19 ? 19 : 7}
                    onChange={(event) =>
                      updateItem(item.id, {
                        confirmed_tax_rate:
                          event.target.value === "19" ? 19 : 7,
                      })
                    }
                    className="min-h-12 w-full rounded-2xl border border-[#D8C8B8] bg-white px-4 font-bold"
                  >
                    <option value={7}>7 %</option>
                    <option value={19}>19 %</option>
                  </select>
                </label>
              </div>
            ) : null}

            <div className="mt-3 rounded-2xl border border-[#F1D1A8] bg-white p-3 text-xs font-semibold leading-5 text-[#52616F]">
              Preisquelle: {item.price_source || "Nicht angegeben"}
              {item.linked_product_id
                ? " · Verknüpftes Produkt wird nach Bestätigung aktualisiert."
                : " · Kein Produkt verknüpft; die Rückmeldung bleibt an der Anfrage gespeichert."}
            </div>
          </div>

          <label className="mt-5 block">
            <span className="mb-2 block text-sm font-black">
              Bemerkung zur Position
            </span>
            <textarea
              rows={3}
              value={item.supplier_note || ""}
              onChange={(event) =>
                updateItem(item.id, {
                  supplier_note: event.target.value,
                })
              }
              className="w-full rounded-2xl border border-[#D8C8B8] bg-white p-4 font-semibold"
            />
          </label>
        </article>
      ))}

      <label className="block rounded-[28px] border border-[#E8DED2] bg-white p-5 shadow-sm">
        <span className="mb-2 block text-sm font-black">
          Allgemeine Rückmeldung
        </span>
        <textarea
          rows={4}
          value={supplierNote}
          onChange={(event) => setSupplierNote(event.target.value)}
          className="w-full rounded-2xl border border-[#D8C8B8] bg-white p-4 font-semibold"
        />
      </label>

      <div className="grid gap-3 sm:grid-cols-2">
        <button
          type="button"
          onClick={() => void saveResponse(false)}
          disabled={isSaving}
          className="inline-flex min-h-14 items-center justify-center gap-2 rounded-2xl border border-[#C8D8E8] bg-white px-6 py-4 text-base font-black text-[#12395F] disabled:opacity-60"
        >
          {isSaving ? (
            <Loader2 className="h-5 w-5 animate-spin" />
          ) : (
            <Save className="h-5 w-5" />
          )}
          Zwischenstand speichern
        </button>

        <button
          type="button"
          onClick={() => void saveResponse(true)}
          disabled={isSaving}
          className="inline-flex min-h-14 items-center justify-center gap-2 rounded-2xl bg-[#B5282D] px-6 py-4 text-base font-black text-white disabled:opacity-60"
        >
          {isSaving ? (
            <Loader2 className="h-5 w-5 animate-spin" />
          ) : (
            <Send className="h-5 w-5" />
          )}
          Rückmeldung vollständig abschließen
        </button>
      </div>
    </div>
  );
}
